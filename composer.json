{
    "name": "tumutech/laravel-qr-code",
    "description": "QR code generation for Laravel — PNG, SVG, Blade, storage, and branded styles",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "qr",
        "qr-code",
        "barcode",
        "vcard",
        "wifi"
    ],
    "authors": [
        {
            "name": "Tumutech"
        }
    ],
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.0",
        "endroid/qr-code": "^5.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tumutech\\QrCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tumutech\\QrCode\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tumutech\\QrCode\\QrCodeServiceProvider"
            ],
            "aliases": {
                "QrCode": "Tumutech\\QrCode\\Facades\\QrCode"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint"
    },
    "suggest": {
        "ext-gd": "Required to generate PNG and WebP images.",
        "ext-imagick": "Optional; used for styled PNG when available."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
